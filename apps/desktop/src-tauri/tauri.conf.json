{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkLet",
  "version": "0.1.0",
  "identifier": "app.inklet.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InkLet",
        "width": 1320,
        "height": 880,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "墨点 · 面向学术写作的 Markdown 编辑器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown"
        ],
        "name": "Markdown Document",
        "description": "InkLet 学术草稿",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "longDescription": "InkLet（墨点）是一个面向学术写作的 Markdown 编辑器：公式用 LaTeX 写法实时渲染，文件是普通的 .md，写完可以导出 PDF。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
